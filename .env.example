# SERVER
# Local-only. Must be "true" (and NODE_ENV !== production) to enable /dev/login.
# Leave unset everywhere else — fail closed.
ALLOW_DEV_LOGIN=
BETTER_AUTH_SECRET=some-secret
BETTER_AUTH_URL=https://my-site.com
GOOGLE_CLIENT_ID=some-id
GOOGLE_CLIENT_SECRET=some-secret
DATABASE_URL=postgresql://ben:password@localhost:5432/rankovo-dev

# PUBLIC
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=foo
